<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9FD8CB"
    android:orientation="vertical"
    tools:context=".DiaryActivity">

    <TextView
        android:id="@+id/diaryTitle"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:background="#517664"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:text="My Diary"
        android:textColor="#D6E5E3"
        android:textSize="34sp" />

    <EditText
        android:id="@+id/diaryEditText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        android:ems="10"
        android:gravity="top|start"
        android:hint="Start writing your thoughts..."
        android:inputType="textMultiLine"
        android:padding="16dp"
        android:textColor="#517664" />

    <TextView
        android:id="@+id/wordCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:text="0/200 words"
        android:textColor="#517664" />

    <Button
        android:id="@+id/saveDiaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#517664"
        android:fontFamily="sans-serif-condensed"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Save"
        android:textColor="#D6E5E3"
        android:textSize="18sp" />

</LinearLayout>