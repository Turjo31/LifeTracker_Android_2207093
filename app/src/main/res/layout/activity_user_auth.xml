<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B1EDE8"
    tools:context=".UserAuthActivity">

    <Button
        android:id="@+id/loginPageButton"
        android:layout_width="190dp"
        android:layout_height="81dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#FF6978"
        android:fontFamily="sans-serif-condensed"
        android:text="Login"
        android:textColor="#FFFCF9"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/signInPageButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/signInPageButton"
        android:layout_width="190dp"
        android:layout_height="81dp"
        android:layout_marginBottom="84dp"
        android:backgroundTint="#4CAF50"
        android:fontFamily="sans-serif-condensed"
        android:text="Sign In"
        android:textColor="#FFFCF9"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>